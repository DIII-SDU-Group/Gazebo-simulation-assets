<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='d4s_dc_drone'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.029125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.029125</iyy>
          <iyz>0</iyz>
          <izz>0.055225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://d4s_dc_drone/meshes/tarot650_model_v2_smaller.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name='base_link_collision_0'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
          	<scale>1 1 1</scale>
          	<uri>model://d4s_dc_drone/meshes/collision_mesh_tarot_v2_smaller.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

