    <!-- Radar-U: simulator-v2 IWR6843AOP on the production upward mount. -->
    <plugin filename="iii_drone_mmwave_conductor_sensor_plugin" name="iii_drone::simulation::MmwaveConductorSensorPlugin">
      <link_name>base_link</link_name>
      <radar_model>AOP_FAST_POINT</radar_model>
      <radar_instance>mmwave</radar_instance>
      <aop_config>model://d4s_dc_drone_powerline_eval/radar/RADAR_U.yaml</aop_config>
      <radar_seed>1</radar_seed>
      <topic>/sensor/mmwave/points</topic>
      <full_topic>/sensor/mmwave/points_full</full_topic>
      <label_topic>/simulation/ground_truth/mmwave/conductor_labels</label_topic>
      <camera_mask_topic>/simulation/ground_truth/cable_camera/conductor_instance_mask</camera_mask_topic>
      <camera_image_topic>/sensor/cable_camera/image_raw</camera_image_topic>
      <camera_info_topic>/sensor/cable_camera/camera_info</camera_info_topic>
      <pylon_semantic_topic>/simulation/ground_truth/cable_camera/pylon_semantic_raw/labels_map</pylon_semantic_topic>
      <pylon_mask_topic>/simulation/ground_truth/cable_camera/pylon_instance_mask</pylon_mask_topic>
      <pylon_asset_uri>model://hcaa_pylon_setup/pylons.yaml</pylon_asset_uri>
      <publish_camera_info>true</publish_camera_info>
      <conductor_id_map_topic>/simulation/ground_truth/conductor_id_map</conductor_id_map_topic>
      <frame_id>mmwave</frame_id>
      <conductor_asset_uri>model://hcaa_pylon_setup/conductors.yaml</conductor_asset_uri>
      <sensor_pose>0.025 -0.24 0.295 3.1415 -1.57079632679 0.0</sensor_pose>
      <camera_pose>0 -0.215 0.3 0 -1.2217304763960306 0</camera_pose>
      <update_rate_hz>30</update_rate_hz>
      <max_point_dist>18.0</max_point_dist>
      <view_cone_slope>0.7</view_cone_slope>
      <plane_half_thickness_m>0.08</plane_half_thickness_m>
      <sigma_along_m>0.12</sigma_along_m>
      <sigma_cross_m>0.03</sigma_cross_m>
      <sigma_normal_m>0.02</sigma_normal_m>
      <dropout_probability>0.02</dropout_probability>
      <corridor_margin_m>0.0</corridor_margin_m>
      <publish_camera>true</publish_camera>
      <publish_drone_state>true</publish_drone_state>
      <publish_static_geometry>true</publish_static_geometry>
      <schedule_offset_ms>0.0</schedule_offset_ms>
      <peer_offset_ms>5.10112</peer_offset_ms>
      <peer_active_ms>12.3405</peer_active_ms>
      <schedule_jitter_sigma_us>5.0</schedule_jitter_sigma_us>
    </plugin>

    <!-- Radar-F: simulator-v2 IWR6843AOP, 50 deg forward from upward. -->
    <plugin filename="iii_drone_mmwave_conductor_sensor_plugin" name="iii_drone::simulation::MmwaveConductorSensorPlugin">
      <link_name>base_link</link_name>
      <radar_model>AOP_FAST_POINT</radar_model>
      <radar_instance>mmwave_forward</radar_instance>
      <aop_config>model://d4s_dc_drone_powerline_eval/radar/RADAR_F.yaml</aop_config>
      <radar_seed>2</radar_seed>
      <topic>/sensor/mmwave_forward/points</topic>
      <full_topic>/sensor/mmwave_forward/points_full</full_topic>
      <label_topic>/simulation/ground_truth/mmwave_forward/conductor_labels</label_topic>
      <frame_id>mmwave_forward</frame_id>
      <camera_mask_topic>/simulation/ground_truth/cable_camera/conductor_instance_mask</camera_mask_topic>
      <camera_image_topic>/sensor/cable_camera/image_raw</camera_image_topic>
      <camera_info_topic>/sensor/cable_camera/camera_info</camera_info_topic>
      <pylon_semantic_topic>/simulation/ground_truth/cable_camera/pylon_semantic_raw/labels_map</pylon_semantic_topic>
      <pylon_mask_topic>/simulation/ground_truth/cable_camera/pylon_instance_mask</pylon_mask_topic>
      <pylon_asset_uri>model://hcaa_pylon_setup/pylons.yaml</pylon_asset_uri>
      <conductor_id_map_topic>/simulation/ground_truth/conductor_id_map</conductor_id_map_topic>
      <conductor_asset_uri>model://hcaa_pylon_setup/conductors.yaml</conductor_asset_uri>
      <sensor_pose>0.105 -0.24 0.285 0.0 -0.6981317007977318 0.0</sensor_pose>
      <camera_pose>0 -0.215 0.3 0 -1.2217304763960306 0</camera_pose>
      <publish_camera>false</publish_camera>
      <publish_drone_state>false</publish_drone_state>
      <publish_static_geometry>false</publish_static_geometry>
      <schedule_offset_ms>5.10112</schedule_offset_ms>
      <peer_offset_ms>0.0</peer_offset_ms>
      <peer_active_ms>4.10112</peer_active_ms>
      <schedule_jitter_sigma_us>5.0</schedule_jitter_sigma_us>
    </plugin>

    <plugin filename="iii_drone_sim_charger_gripper_plugin" name="iii_drone::simulation::SimChargerGripperPlugin">
      <link_name>base_link</link_name>
      <conductor_asset_uri>model://hcaa_pylon_setup/conductors.yaml</conductor_asset_uri>
      <!-- Keep this exactly aligned with /tf/sim/drone_to_cable_gripper
           (x y z yaw pitch roll = 0 0 0.4 pi/2 0 0): the gripper x axis runs
           along the cable, i.e. along the collision mesh's slot (base_link y),
           and z points out of the slot opening. -->
      <gripper_pose>0.0 0.0 0.4 0.0 0.0 1.57079632679</gripper_pose>
      <command_topic>/sim/charger_gripper/command</command_topic>
      <state_topic>/sim/charger_gripper/state</state_topic>
      <capture_min>-0.25 -0.25 -0.35</capture_min>
      <capture_max>0.25 0.25 0.12</capture_max>
      <!-- The seat: conductor centre resting on the slot floor (base_link
           z 0.344) with the conductor radius from conductors.yaml. -->
      <latch_local_point>0.0 0.0 -0.0435</latch_local_point>
      <latch_radius>0.04</latch_radius>
      <latch_along_tolerance>0.18</latch_along_tolerance>
      <conductor_radius>0.0125</conductor_radius>
      <required_contact_duration_ms>40</required_contact_duration_ms>
      <!-- The slot floor and walls are collisions of the airframe mesh. The
           closed jaws keep the conductor within jaw_clearance of the seat (a
           hanging vehicle rests on them) and within wall_clearance of the
           slot centre, grip along it, and their friction damps rotation
           about it (about half of critical for this vehicle's swing). Once
           open, only the physical floor and walls remain. -->
      <jaw_clearance>0.005</jaw_clearance>
      <wall_clearance>0.007</wall_clearance>
      <jaw_stiffness>4000.0</jaw_stiffness>
      <jaw_damping>150.0</jaw_damping>
      <jaw_rotational_damping>1.0</jaw_rotational_damping>
      <along_hold_stiffness>600.0</along_hold_stiffness>
      <along_hold_damping>80.0</along_hold_damping>
      <support_force_limit>250.0</support_force_limit>
      <support_ramp_duration_s>0.35</support_ramp_duration_s>
    </plugin>



