<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='d4s_dc_drone_powerline_eval'>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name='base_link'>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.029125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.029125</iyy>
          <iyz>0</iyz>
          <izz>0.055225</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://d4s_dc_drone/meshes/tarot650_model_v2_smaller.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='debug_gripper_v_gate_origin'>
        <pose>-0.0025 -0.005 0.3575 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.0 0.25 1.0 1.0</ambient>
          <diffuse>0.0 0.25 1.0 1.0</diffuse>
          <emissive>0.0 0.08 0.35 1.0</emissive>
        </material>
      </visual>
      <visual name='debug_gripper_v_gate_apex'>
        <pose>-0.0025 -0.005 0.2475 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.1 0.0 1.0</ambient>
          <diffuse>1.0 0.1 0.0 1.0</diffuse>
          <emissive>0.35 0.02 0.0 1.0</emissive>
        </material>
      </visual>
      <visual name='debug_gripper_v_gate_left'>
        <pose>-0.0425 -0.005 0.3175 0 -0.519146 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.161245</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.8 0.0 1.0</ambient>
          <diffuse>1.0 0.8 0.0 1.0</diffuse>
          <emissive>0.35 0.25 0.0 1.0</emissive>
        </material>
      </visual>
      <visual name='debug_gripper_v_gate_right'>
        <pose>0.0375 -0.005 0.3175 0 0.519146 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.161245</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.8 0.0 1.0</ambient>
          <diffuse>1.0 0.8 0.0 1.0</diffuse>
          <emissive>0.35 0.25 0.0 1.0</emissive>
        </material>
      </visual>
      <collision name='base_link_inertia_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <!-- <box>
            <size>0.47 0.47 0.11</size>
          </box> -->
          <mesh>
          	<scale>1 1 1</scale>
          	<uri>model://d4s_dc_drone/meshes/collision_mesh_tarot_v2_smaller.stl</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.035 -0.23 0.28 0 -1.571 0</pose>
        <!-- <pose>0.035 -0.23 0.28 0 -1.571 0</pose> -->
        <update_rate>30</update_rate>
        <topic>/depth_camera</topic>
        <camera>
          <horizontal_fov>2.3</horizontal_fov>
          <!-- <vertical_fov>2.8</vertical_fov> -->
          <image>
            <width>256</width>
            <height>256</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>30000</far>
          </clip>
        </camera>
      </sensor>

      <sensor type="camera" name="cable_camera">
        <pose>0 -0.215 0.3 0 -1.2217304763960306 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/sensor/cable_camera/image_raw</topic>
        <gz_frame_id>cable_camera</gz_frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>30000</far>
          </clip>
          <lens>
          </lens>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- Evaluator-only, renderer-exact pylon labels.  Pose, rate, FOV,
           resolution and clipping are intentionally identical to cable_camera.
           The runtime graph must never subscribe to this topic. -->
      <sensor type="segmentation" name="pylon_semantic_camera">
        <pose>0 -0.215 0.3 0 -1.2217304763960306 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/simulation/ground_truth/cable_camera/pylon_semantic_raw</topic>
        <camera>
          <segmentation_type>semantic</segmentation_type>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.02</near>
            <far>30000</far>
          </clip>
        </camera>
      </sensor>


      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <!-- White noise follows PX4's upstream x500 model (IIM42653: 0.65/0.70 mg rms).
                 Bias drift is a Gauss-Markov process (random walk 0.0006 m/s^3/sqrt(Hz),
                 300 s correlation, about 0.75 mg steady-state), still ~3x the calibrated
                 ADIS16448 random walk (0.0002). The previous 0.006 (RotorS default) drifted
                 about 30x more than that part and let SITL EKF2 height drift 0.5 m at rest. -->
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00637</stddev>
                <dynamic_bias_stddev>0.0006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00637</stddev>
                <dynamic_bias_stddev>0.0006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.00686</stddev>
                <dynamic_bias_stddev>0.0006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <link name="rotor_0">
