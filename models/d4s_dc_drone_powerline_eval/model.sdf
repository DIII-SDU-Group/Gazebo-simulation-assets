    <!-- Authoritative simulator state for dataset recording. This is kept on a
         dedicated topic so it cannot be confused with PX4 estimator output. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>drone</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/simulation/ground_truth/drone/odometry</odom_topic>
    </plugin>

  </model>
